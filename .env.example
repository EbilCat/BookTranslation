# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# `.env` is git-ignored — never commit real secrets.

# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------

# Your SEA-LION API key. Get one at: https://docs.sea-lion.ai/guides/inferencing/api
SEA_LION_API_KEY=

# ----------------------------------------------------------------------------
# Required only for the LLM-as-a-judge step (`--judge`)
# ----------------------------------------------------------------------------

# Google Gemini API key, used by the translation-quality judge (a separate
# provider, so it never competes with SEA-LION's rate budget or grades its own
# output). Free tier works. Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------

# Model identifier to query. The one setting you're most likely to change.
# SEA_LION_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT

# ----------------------------------------------------------------------------
# Advanced overrides (defaults shown; rarely need changing)
# ----------------------------------------------------------------------------

# SEA-LION API base URL.
# SEA_LION_BASE_URL=https://api.sea-lion.ai/v1

# Per-request timeout in seconds.
# SEA_LION_TIMEOUT=120

# Assumed model context window in tokens (the translator degrades on failure).
# SEA_LION_CONTEXT_WINDOW=128000

# Judge model and endpoint (used only with --judge). Defaults target Gemini's
# OpenAI-compatible endpoint with a "-latest" alias so a model deprecation never
# breaks the default. Override the model for a stronger judge (e.g. a current
# full-Flash model); pick one your key can call via the models list.
# JUDGE_MODEL=gemini-flash-lite-latest
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# JUDGE_TIMEOUT=120

# Note: target language and source book URL are CLI arguments, not env vars.
#   uv run main.py --language th --book-url <url>
